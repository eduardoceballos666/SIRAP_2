# Copie este archivo como .env (no se sube a GitHub). La API FastAPI lo lee al iniciar; en Streamlit Cloud o
# Hugging Face Spaces defina los mismos nombres como Secrets.

# --- API FastAPI + Vue ---
# Clave para firmar las sesiones (JWT). Use una cadena larga y aleatoria: python -c "import secrets;print(secrets.token_urlsafe(48))"
SIRAP_JWT_SECRET=
# Contraseña inicial de los usuarios de demostración operador / supervisor / admin (por defecto sirap2026).
SIRAP_DEMO_PASSWORD=


# PIN para el módulo Administración de la app Streamlit (sin esto queda abierta: solo para la demo).
SIRAP_ADMIN_PIN=

# Descarga del dataset para reentrenar (src/train.py --roboflow).
ROBOFLOW_API_KEY=

# Controlador físico de la barrera (config.yaml → barrera.modo: "http").
# BARRERA_URL=https://garita3.local/abrir
BARRERA_TOKEN=

# Exportación de detecciones a un CSV persistente de GitHub.
# Use un repositorio PRIVADO distinto (o convierta uno en privado) para evitar publicar placas y nombres.
# El token fine-grained debe estar limitado a ese repositorio con Contents: Read and write.
GITHUB_TOKEN=
GITHUB_DATA_REPOSITORY=
GITHUB_DATA_BRANCH=main
GITHUB_DATA_PATH=data/detecciones.csv
