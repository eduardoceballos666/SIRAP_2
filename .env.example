# Copie este archivo como .env (no se sube a GitHub) o defina estos valores en
# Streamlit Cloud → App settings → Secrets (formato TOML: NOMBRE = "valor").

# PostgreSQL de producción (Supabase, Neon, servidor propio). Sin esto la app usa SQLite de demostración.
PG_DSN=postgresql://usuario:clave@host:5432/sirap?sslmode=require

# PIN para el módulo Administración (sin esto, la administración queda abierta: solo para la demo).
SIRAP_ADMIN_PIN=

# Descarga del dataset para reentrenar (src/train.py --roboflow).
ROBOFLOW_API_KEY=

# Controlador físico de la barrera (config.yaml → barrera.modo: "http").
BARRERA_URL=https://garita3.local/abrir
BARRERA_TOKEN=
