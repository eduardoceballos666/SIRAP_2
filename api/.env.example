# Variables locales de desarrollo. Docker de producción fuerza SIRAP_GITHUB_REQUIRED=1.
SIRAP_JWT_SECRET=
SIRAP_JWT_HOURS=12
# Solo bootstrap local para hashes ausentes; no se usa en producción ni debe compartirse.
SIRAP_DEMO_PASSWORD=
SIRAP_DATA_DIR=data/processed
# Desarrollo local: use 0 para CSV sin conexión a GitHub.
SIRAP_GITHUB_REQUIRED=0
SIRAP_DATA_GITHUB_REPO=eduardoceballos666/SIRAP_datos_privados
# SIRAP_DATA_GITHUB_TOKEN=CONFIGURAR_COMO_SECRETO_FUERA_DEL_REPOSITORIO
SIRAP_CORS_ORIGINS=http://localhost:5173
# BARRERA_URL= / BARRERA_TOKEN=                         # controlador real de la barrera (por defecto, simulada)
