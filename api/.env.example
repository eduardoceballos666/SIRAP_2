# Variables de la API (copiar a .env o exportarlas antes de `uvicorn api.main:app`).
SIRAP_JWT_SECRET=cambie-esto-por-una-cadena-larga-y-aleatoria
SIRAP_JWT_HOURS=12
# Contraseña inicial de las cuentas de demostración (cámbiela fuera de la demo pública).
SIRAP_DEMO_PASSWORD=sirap2026
SIRAP_DATA_DIR=data/processed
# Producción: GitHub PRIVADO es la única fuente persistente; el disco del hosting es caché.
# En desarrollo local use 0 si quiere CSV sin conexión a GitHub.
SIRAP_GITHUB_REQUIRED=1
SIRAP_DATA_GITHUB_REPO=eduardoceballos666/SIRAP_datos_privados
# SIRAP_DATA_GITHUB_TOKEN=CONFIGURAR_COMO_SECRETO_FUERA_DEL_REPOSITORIO
SIRAP_CORS_ORIGINS=http://localhost:5173
# BARRERA_URL= / BARRERA_TOKEN=                         # controlador real de la barrera (por defecto, simulada)
