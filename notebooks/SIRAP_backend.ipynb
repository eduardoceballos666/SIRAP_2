    "# ===================== Fuente de archivos: GitHub, sin montar Google Drive =====================\n",
    "REPOSITORY_URL = \"https://github.com/eduardoceballos666/SIRAP_2.git\"\n",
    "REPO_ROOT = Path(\"/content/SIRAP_2\")\n",
    "if not (REPO_ROOT / \".git\").exists():\n",
    "    if REPO_ROOT.exists():\n",
    "        shutil.rmtree(REPO_ROOT)\n",
    "    subprocess.run([\"git\", \"clone\", \"--depth\", \"1\", REPOSITORY_URL, str(REPO_ROOT)], check=True)\n",
    "\n",
    "# Los resultados de una sesión van a este espacio temporal; los insumos versionados se leen desde REPO_ROOT.\n",
    "WORK_DIR = Path(\"/content/SIRAP_workspace\")\n",
    "WORK_DIR.mkdir(parents=True, exist_ok=True)\n",
    "SAVH_ZIP_CANDIDATES = [REPO_ROOT / \"evidence/savh/revision_visual/savh_ground_truth_subset.zip\",\n",
    "                       REPO_ROOT / \"savh_ground_truth_subset.zip\"]\n",
    "REVIEW_SHEET_ID = \"\"  # no se consulta Google Sheets; se usa la copia CSV versionada\n",
    "USE_GOOGLE_SHEET = False\n",
    "REVIEW_CSV_FALLBACK = REPO_ROOT / \"evidence/savh/ocr/revision_placas_142_leida.csv\"\n",
    "AUTHORIZED_LIST_PATH = REPO_ROOT / \"data/authorized_plates.csv\"\n",
    "REAL_VIDEO_PATH = REPO_ROOT / \"artifacts/video_camiones.mp4\"  # opcional: video completo si se publica como artefacto\n",
    "VIDEO_GROUND_TRUTH_PATH = WORK_DIR / \"video_ground_truth.csv\"  # referencia manual opcional; no se inventa\n",
    "E2E_IMAGES_DIR = REPO_ROOT / \"garita/imagenes\"  # opcional: fotogramas completos de la garita\n",
    "E2E_GROUND_TRUTH_CSV = REPO_ROOT / \"garita/ground_truth.csv\"  # opcional: etiquetas reales revisadas\n",
    "LOCAL_DATASET_ZIP = REPO_ROOT / \"data/raw/dataset_placas_yolo.zip\"  # opcional; alternativa a Roboflow\n",
    "LIVE_DIR = WORK_DIR / \"en_vivo\"\n",
    "BRIDGE_SCRIPT_PATH = LIVE_DIR / \"puente_camara.py\"\n",
    "LIVE_DIR.mkdir(exist_ok=True)\n",
    "\n",
    "\n",
    "def input_status(path: Path) -> str:\n",
    "    \"\"\"Estado de una entrada: «ok», «vacío» (archivo de 0 bytes) o «no está».\"\"\"\n",
    "    if not path.exists():\n",
    "        return \"no está (opcional o falta publicar el artefacto)\"\n",
    "    if path.is_file() and path.stat().st_size == 0:\n",
    "        return \"vacío\"\n",
    "    return \"ok\"\n",
    "\n",
    "\n",
    "static_inputs = [(\"SAVH: recortes y ground_truth.csv\", SAVH_ZIP_CANDIDATES[0]),\n",
    "                 (\"Revisión de placas: CSV versionado\", REVIEW_CSV_FALLBACK),\n",
    "                 (\"Placas autorizadas\", AUTHORIZED_LIST_PATH),\n",
    "                 (\"Video completo de la garita (opcional)\", REAL_VIDEO_PATH),\n",
    "                 (\"Referencia de video (opcional)\", VIDEO_GROUND_TRUTH_PATH),\n",
    "                 (\"Imágenes y referencia de garita (opcionales)\", E2E_GROUND_TRUTH_CSV),\n",
