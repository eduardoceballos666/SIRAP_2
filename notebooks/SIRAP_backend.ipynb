    "# 6.10 · Lecturas de la corrida actual con los datos disponibles en CSV, SRI y propietario\n",
    "sri.wait()\n",
    "if \"propietario\" in globals() and propietario.store is store:\n",
    "    propietario.wait()\n",
    "video_name = Path(SOURCE_VIDEO_PATH).name\n",
    "corridas = [run_name(model) + tag for model, _, tag in CONFIGS.values()]\n",
    "datos = store.verified_readings()\n",
    "if datos.empty:\n",
    "    print(\"Todavía no hay lecturas en registros_csv/lecturas.csv.\")\n",
    "else:\n",
    "    actual = datos[(datos[\"video\"].astype(str) == video_name) & datos[\"corrida\"].astype(str).isin(corridas)].copy()\n",
    "    if actual.empty:\n",
    "        print(\"No hay lecturas de las corridas actuales.\")\n",
    "    else:\n",
    "        # Asegurar que las columnas del propietario existan para evitar KeyErrors si el CSV de origen estaba vacío\n",
    "        for col in [\"propietario_nombre\", \"propietario_fuente\", \"propietario_consultado_en\"]:\n",
    "            if col not in actual.columns:\n",
    "                actual[col] = \"\"\n",
    "\n",
    "        resumen = actual.groupby(\"modelo\", dropna=False).agg(\n",
    "            lecturas=(\"placa\", \"size\"), placas_distintas=(\"placa\", \"nunique\"),\n",
    "            autorizadas=(\"estado_acceso\", lambda x: int((x == \"AUTORIZADO\").sum())),\n",
    "            encontradas_en_sri=(\"sri_encontrado\", lambda x: int(x.astype(str).str.lower().isin([\"true\", \"1\"]).sum())),\n",
    "            con_propietario=(\"propietario_nombre\", lambda x: int(x.astype(str).ne(\"\").sum()))).reset_index()\n",
    "        display(resumen)\n",
    "        columns = [c for c in (\"modelo\", \"segundo_video\", \"placa\", \"estado_acceso\", \"autorizado_por_csv\",\n",
    "                    \"sri_marca\", \"sri_modelo\", \"sri_anio_modelo\", \"sri_ultimo_anio_pagado\",\n",
    "                    \"sri_matricula_al_dia\", \"sri_rubros_pendientes\", \"sri_alerta\",\n",
    "                    \"propietario_nombre\", \"propietario_fuente\", \"propietario_consultado_en\") if c in actual]\n",
    "        display(actual[columns].sort_values([\"segundo_video\", \"modelo\"]))\n",
    "store.save()\n",
    "print(\"CSV de trabajo:\", PIPELINE_CSV_DIR)"
