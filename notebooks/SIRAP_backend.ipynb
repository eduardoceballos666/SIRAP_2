   "source": [
    "# 3.4 · Carga de fast-plate-ocr\n",
    "from fast_plate_ocr import LicensePlateRecognizer\n",
    "\n",
    "# En la CPU con ONNX Runtime: unos 16 ms por placa, y la GPU queda para el detector. En cada sesión nueva descarga el\n",
    "# modelo (5 MB) de las versiones publicadas de fast-plate-ocr en GitHub.\n",
    "OCR_DEVICE = \"cpu\"\n",
    "ocr_model = LicensePlateRecognizer(OCR_MODEL_NAME, device=OCR_DEVICE)\n",
    "print(f\"OCR: fast-plate-ocr {OCR_MODEL_NAME} en {OCR_DEVICE} · entrada {ocr_model.config.img_width}×\"\n",
    "      f\"{ocr_model.config.img_height} px · {ocr_model.config.max_plate_slots} posiciones · caracteres \"\n",
    "      f\"{ocr_model.config.alphabet.replace(ocr_model.config.pad_char, '')}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b4be4244",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "b4be4244",
    "outputId": "e163e06e-1d21-4116-88c6-39062eff3462",
    "executionInfo": {
     "status": "ok",
     "timestamp": 1793519731453,
     "user_tz": 300,
     "elapsed": 65,
     "user": {
      "displayName": "Eduardo Ceballos",
